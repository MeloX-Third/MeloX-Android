{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melox.invalid/plugin/protocol-v1.schema.json",
  "title": "MeloX Plugin API v1 standard transport",
  "$defs": {
    "uiRequest": {"type": "object","properties": {"entry": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"page": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"index": {"type": "integer","minimum": 1,"maximum": 10000},"query": {"type": "string","maxLength": 1024},"scope": {"type": "object","properties": {"type": {"enum": ["track","playlist","album","artist"]},"id": {"$ref": "#/$defs/resourceId"}},"required": ["type","id"]}},"required": ["entry","page","index","query"]},
    "uiActionRequest": {"type": "object","properties": {"entry": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"page": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"index": {"type": "integer","minimum": 1,"maximum": 10000},"query": {"type": "string","maxLength": 1024},"scope": {"type": "object","properties": {"type": {"enum": ["track","playlist","album","artist"]},"id": {"$ref": "#/$defs/resourceId"}},"required": ["type","id"]},"control": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"value": {"oneOf": [{"type": "string","maxLength": 2048},{"type": "boolean"},{"type": "number","minimum": -1000000000,"maximum": 1000000000},{"type": "array","items": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"maxItems": 30,"uniqueItems": true}]}},"required": ["entry","page","index","query","control"]},
    "uiControl": {"oneOf": [{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "toggle"},"value": {"type": "boolean"}},"required": ["id","type","label","value"]},{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "singleChoice"},"options": {"type": "array","minItems": 1,"maxItems": 30,"items": {"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"}},"required": ["id","label"]}},"value": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"}},"required": ["id","type","label","options","value"]},{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "multiChoice"},"options": {"type": "array","minItems": 1,"maxItems": 30,"items": {"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"}},"required": ["id","label"]}},"value": {"type": "array","uniqueItems": true,"maxItems": 30,"items": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"}}},"required": ["id","type","label","options","value"]},{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "slider"},"min": {"type": "number","minimum": -1000000000,"maximum": 1000000000},"max": {"type": "number","minimum": -1000000000,"maximum": 1000000000},"value": {"type": "number","minimum": -1000000000,"maximum": 1000000000}},"required": ["id","type","label","min","max","value"]},{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "number"},"value": {"type": "number","minimum": -1000000000,"maximum": 1000000000}},"required": ["id","type","label","value"]},{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "text"},"value": {"type": "string","maxLength": 2048}},"required": ["id","type","label","value"]},{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "secret"},"value": false},"required": ["id","type","label"]},{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "url"},"value": {"type": "string","maxLength": 2048}},"required": ["id","type","label","value"]},{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "button"}},"required": ["id","type","label"]},{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "link"},"target": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"}},"required": ["id","type","label","target"]},{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "status"},"value": {"type": "string","maxLength": 2048}},"required": ["id","type","label","value"]},{"type": "object","properties": {"id": {"type": "string","pattern": "^[A-Za-z0-9_-]{1,64}$"},"label": {"type": "string","maxLength": 120,"pattern": "\\S"},"description": {"type": "string","maxLength": 512},"disabled": {"type": "boolean"},"type": {"const": "qr"},"value": {"type": "string","maxLength": 512,"pattern": "\\S"}},"required": ["id","type","label","value"]}]},
    "uiPage": {"type": "object","properties": {"title": {"type": "string","maxLength": 120,"pattern": "\\S"},"template": {"enum": ["settings","connection","collection","detail","search","status"]},"controls": {"type": "array","maxItems": 50,"items": {"$ref": "#/$defs/uiControl"}},"tracks": {"type": "array","maxItems": 30,"items": {"$ref": "#/$defs/track"}},"hasMore": {"type": "boolean"}},"required": ["title","template","controls"]},
    "uiAction": {"type": "object","properties": {"message": {"type": "string","maxLength": 512},"refresh": {"type": "boolean"}}},
    "resourceId": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" },
    "quality": { "enum": ["standard", "high", "lossless", "hiResolution", "immersive", "master"] },
    "availability": { "enum": ["unknown", "playable", "previewOnly", "loginRequired", "subscriptionRequired", "regionRestricted", "copyrightRestricted", "unavailable"] },
    "artistRef": {
      "type": "object", "required": ["name"],
      "properties": { "id": { "$ref": "#/$defs/resourceId" }, "name": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" } }
    },
    "albumRef": {
      "type": "object", "required": ["name"],
      "properties": { "id": { "$ref": "#/$defs/resourceId" }, "name": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S" }, "artworkUrl": { "type": "string", "maxLength": 4096 } }
    },
    "track": {
      "type": "object", "required": ["id", "title", "artists"],
      "properties": {
        "id": { "$ref": "#/$defs/resourceId" },
        "source": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S" },
        "artists": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/artistRef" } },
        "album": { "$ref": "#/$defs/albumRef" }, "artworkUrl": { "type": "string", "maxLength": 4096 },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "availability": { "$ref": "#/$defs/availability" }, "bestQuality": { "$ref": "#/$defs/quality" },
        "bestBitrate": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "searchPage": {
      "type": "object", "required": ["items", "page", "pageSize", "hasMore"],
      "properties": {
        "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/track" } },
        "page": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
        "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "hasMore": { "type": "boolean" }
      }
    },
    "playbackResolution": {
      "oneOf": [
        { "type": "object", "required": ["type", "url"], "properties": {
          "type": { "const": "playable" }, "url": { "type": "string", "maxLength": 4096 },
          "credential": { "const": "active" },
          "headers": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": "string", "maxLength": 4096 } },
          "actualQuality": { "$ref": "#/$defs/quality" }, "bitrate": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "format": { "type": "string", "maxLength": 64, "not": { "pattern": "^(?:[hH][lL][sS]|[dD][aA][sS][hH]|[mM]3[uU]8|[mM][pP][dD]|[dD][rR][mM])$" } },
          "drm": false, "licenseUrl": false,
          "expiresAtEpochMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        } },
        { "type": "object", "required": ["type", "url"], "properties": { "type": { "const": "preview" }, "url": { "type": "string", "maxLength": 4096 }, "durationMs": { "type": "integer", "minimum": 1, "maximum": 86400000 } } },
        { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["loginRequired", "subscriptionRequired", "regionRestricted", "copyrightRestricted"] } } },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "unavailable" }, "reason": { "type": "string", "maxLength": 512 } } }
      ]
    },
    "playlist": {
      "type": "object", "required": ["id", "title"], "properties": {
        "id": { "$ref": "#/$defs/resourceId" }, "title": { "$ref": "#/$defs/catalogText" },
        "creatorName": { "$ref": "#/$defs/catalogText" }, "description": { "$ref": "#/$defs/catalogText" }, "artworkUrl": { "type": "string", "maxLength": 4096 },
        "trackCount": { "type": "integer", "minimum": 0, "maximum": 2147483647 }, "playCount": { "$ref": "#/$defs/count" }, "isEditable": { "type": "boolean" }
      }
    },
    "album": {
      "type": "object", "required": ["id", "title"], "properties": {
        "id": { "$ref": "#/$defs/resourceId" }, "title": { "$ref": "#/$defs/catalogText" },
        "artists": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/artistRef" } }, "artworkUrl": { "type": "string", "maxLength": 4096 },
        "trackCount": { "$ref": "#/$defs/count" }, "releaseDate": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" }
      }
    },
    "artist": {
      "type": "object", "required": ["id", "name"], "properties": {
        "id": { "$ref": "#/$defs/resourceId" }, "name": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" },
        "description": { "$ref": "#/$defs/catalogText" }, "songCount": { "$ref": "#/$defs/count" }, "albumCount": { "$ref": "#/$defs/count" }, "artworkUrl": { "type": "string", "maxLength": 4096 }
      }
    },
    "ranking": {
      "type": "object", "required": ["id", "title"], "properties": {
        "id": { "$ref": "#/$defs/resourceId" }, "title": { "$ref": "#/$defs/catalogText" }, "subtitle": { "$ref": "#/$defs/catalogText" }, "artworkUrl": { "type": "string", "maxLength": 4096 }
      }
    },
    "catalogText": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "page": {
      "type": "object", "required": ["items", "page", "pageSize", "hasMore"], "properties": {
        "items": { "type": "array", "maxItems": 100 }, "page": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 }, "total": { "$ref": "#/$defs/count" }, "hasMore": { "type": "boolean" }
      }
    },
    "playlistPage": { "allOf": [{ "$ref": "#/$defs/page" }, { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/playlist" } } } }] },
    "albumPage": { "allOf": [{ "$ref": "#/$defs/page" }, { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/album" } } } }] },
    "artistPage": { "allOf": [{ "$ref": "#/$defs/page" }, { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/artist" } } } }] },
    "rankingPage": { "allOf": [{ "$ref": "#/$defs/page" }, { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/ranking" } } } }] },
    "playlistDetail": { "type": "object", "required": ["summary", "tracks"], "properties": { "summary": { "$ref": "#/$defs/playlist" }, "tracks": { "$ref": "#/$defs/searchPage" }, "memberIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/resourceId" } } } },
    "albumDetail": { "type": "object", "required": ["summary", "tracks"], "properties": { "summary": { "$ref": "#/$defs/album" }, "tracks": { "$ref": "#/$defs/searchPage" } } },
    "artistDetail": { "type": "object", "required": ["summary", "tracks"], "properties": { "summary": { "$ref": "#/$defs/artist" }, "tracks": { "$ref": "#/$defs/searchPage" } } },
    "homeFeed": {
      "type": "object", "required": ["recommendedPlaylists", "newSongs", "rankings"], "properties": {
        "recommendedPlaylists": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/playlist" } },
        "newSongs": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/track" } },
        "rankings": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/ranking" } }
      }
    },
    "account": {
      "type": "object", "required": ["id", "displayName"], "properties": {
        "id": { "$ref": "#/$defs/resourceId" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" }, "subtitle": { "$ref": "#/$defs/catalogText" }, "avatarUrl": { "type": "string", "maxLength": 4096 }
      }
    },
    "accountSummary": { "anyOf": [{ "$ref": "#/$defs/account" }, { "type": "null" }] },
    "authenticationStatus": {
      "oneOf": [
        { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["notRequired", "signedOut"] } } },
        { "type": "object", "required": ["type", "account"], "properties": { "type": { "const": "signedIn" }, "account": { "$ref": "#/$defs/account" } } },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "expired" }, "accountId": { "$ref": "#/$defs/resourceId" } } }
      ]
    },
    "favoriteState": { "type": "boolean" },
    "writeAcknowledgement": { "type": "null" },
    "lyrics": {
      "type": "object", "required": ["lines"],
      "properties": {
        "isUnsynchronized": { "type": "boolean" },
        "lines": { "type": "array", "maxItems": 2000, "items": {
          "type": "object", "required": ["timeMs", "text"],
          "properties": {
            "timeMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
            "durationMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
            "text": { "type": "string", "maxLength": 4096 },
            "translation": { "type": "string", "maxLength": 4096 }, "romanization": { "type": "string", "maxLength": 4096 }
          }
        } }
      }
    }
  }
}
